{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/map-token", "destination": "/api/map-token.js" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}